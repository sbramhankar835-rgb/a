<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Photo</title>

  <!-- QR Code library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
    }

    .card {
      width: 90%;
      max-width: 400px;
      padding: 25px;
      text-align: center;
      background: white;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }

    h1 {
      margin-top: 0;
    }

    .photo {
      width: 100%;
      max-height: 350px;
      object-fit: cover;
      border-radius: 15px;
      margin: 15px 0;
    }

    #qrcode {
      display: flex;
      justify-content: center;
      margin: 20px 0;
    }

    .small {
      color: #666;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <div class="card">
    <h1>📸 My Photo</h1>

    <!-- Put your photo in the same folder and name it photo.jpg -->
    <img src="photo.jpg" class="photo" alt="My Photo">

    <p>Scan this QR code to open this page:</p>

    <div id="qrcode"></div>

    <p class="small">Share the QR code with your friends.</p>
  </div>

  <script>
    // Automatically uses the current webpage address
    new QRCode(document.getElementById("qrcode"), {
      text: window.location.href,
      width: 180,
      height: 180
    });
  </script>

</body>
</html>